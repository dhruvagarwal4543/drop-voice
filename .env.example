# Flutter App Configuration

# The URL of your local or remote token server
# For Android emulator using localhost: 10.0.2.2
# For iOS simulator using localhost: 127.0.0.1
# For physical devices, use the local IP of your machine on the network
TOKEN_SERVER_URL=http://localhost:3000

# Firebase configuration is handled automatically by FlutterFire CLI,
# but if you need to provide API keys manually, do it here.
