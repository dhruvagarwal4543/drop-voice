rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──────────────────────────────────────────────────────────────────
    // Any authenticated user can read profiles (for search/friends).
    // Only the owner can write their own profile.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // ── Rooms ──────────────────────────────────────────────────────────────────
    match /rooms/{roomCode} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt is timestamp;
      allow update: if request.auth != null
        && resource.data.hostId == request.auth.uid;
      allow delete: if false;
    }

    // ── Friendships ────────────────────────────────────────────────────────────
    // Participants in the friendship can read and write it.
    match /friendships/{friendshipId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.participants;
    }

    // ── Conversations ─────────────────────────────────────────────────────────
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null
        && (request.auth.uid in resource.data.participants
            || request.auth.uid in request.resource.data.participants);

      // Messages — only conversation participants can access
      match /messages/{messageId} {
        function isParticipant() {
          return request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }
        allow read, write: if request.auth != null && isParticipant();
      }
    }
  }
}
